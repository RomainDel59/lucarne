<?xml version="1.0" encoding="utf-8"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
  <id>lucarne</id>
  <name>Lucarne</name>
  <summary>A calm, private YouTube library</summary>
  <description><![CDATA[
Follow YouTube channels, organize playlists and watch videos from a focused interface inside Nextcloud.
Lucarne stores its catalogue and media in its own AppAPI persistent volume.
  ]]></description>
  <version>1.0.0</version>
  <licence>AGPL-3.0-or-later</licence>
  <author>Lucarne contributors</author>
  <namespace>Lucarne</namespace>
  <category>multimedia</category>
  <website>https://github.com/lucarne-app/lucarne</website>
  <bugs>https://github.com/lucarne-app/lucarne/issues</bugs>
  <repository type="git">https://github.com/lucarne-app/lucarne.git</repository>
  <dependencies>
    <nextcloud min-version="35" max-version="36" />
  </dependencies>
  <external-app>
    <docker-install>
      <registry>ghcr.io</registry>
      <image>lucarne-app/lucarne</image>
      <image-tag>1.0.0</image-tag>
    </docker-install>
    <routes>
      <route>
        <url>^/api/admin/.*</url>
        <verb>GET,PUT</verb>
        <access_level>ADMIN</access_level>
        <headers_to_exclude>[]</headers_to_exclude>
      </route>
      <route>
        <url>^/api/agent(?:/.*)?$</url>
        <verb>GET,POST,DELETE</verb>
        <access_level>ADMIN</access_level>
        <headers_to_exclude>[]</headers_to_exclude>
      </route>
      <route>
        <url>^/api/.*</url>
        <verb>GET,POST,PUT,DELETE</verb>
        <access_level>USER</access_level>
        <headers_to_exclude>[]</headers_to_exclude>
      </route>
      <route>
        <url>^/media/.*</url>
        <verb>GET</verb>
        <access_level>USER</access_level>
        <headers_to_exclude>[]</headers_to_exclude>
      </route>
      <route>
        <url>^/(js|css|img)/.*</url>
        <verb>GET</verb>
        <access_level>USER</access_level>
        <headers_to_exclude>[]</headers_to_exclude>
      </route>
    </routes>
  </external-app>
</info>
