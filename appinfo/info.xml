<?xml version="1.0" encoding="utf-8"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
  <id>lucarne</id>
  <name>Lucarne</name>
  <summary>A calm, private library for your own YouTube subscriptions</summary>
  <description><![CDATA[
Follow YouTube channels, organize playlists and watch videos from a focused interface inside Nextcloud. Lucarne is meant for your own subscriptions and stores its catalogue and media in its own AppAPI persistent volume.

**Third-party service.** The Lucarne server contacts YouTube to read channel, playlist and video information and to fetch the media you play. Your use of YouTube remains subject to its terms of service, and you are responsible for complying with them and with copyright law. Lucarne is not affiliated with or endorsed by YouTube or Nextcloud.

Lucarne includes no analytics, advertisements or tracking, and does not require a YouTube account.
  ]]></description>
  <version>1.3.1</version>
  <licence>AGPL-3.0-or-later</licence>
  <author homepage="https://github.com/RomainDel59">RomainDel59</author>
  <namespace>Lucarne</namespace>
  <documentation>
    <user>https://github.com/RomainDel59/lucarne#readme</user>
  </documentation>
  <category>multimedia</category>
  <website>https://github.com/RomainDel59/lucarne</website>
  <bugs>https://github.com/RomainDel59/lucarne/issues</bugs>
  <repository type="git">https://github.com/RomainDel59/lucarne.git</repository>
  <screenshot>https://raw.githubusercontent.com/RomainDel59/lucarne/master/docs/screenshot-home.png</screenshot>
  <screenshot>https://raw.githubusercontent.com/RomainDel59/lucarne/master/docs/screenshot-subscriptions.png</screenshot>
  <dependencies>
    <nextcloud min-version="35" max-version="36" />
  </dependencies>
  <external-app>
    <docker-install>
      <registry>ghcr.io</registry>
      <image>romaindel59/lucarne</image>
      <image-tag>1.3.1</image-tag>
    </docker-install>
    <routes>
      <route>
        <url>^/api/admin/.*</url>
        <verb>GET,PUT</verb>
        <access_level>ADMIN</access_level>
        <headers_to_exclude>[]</headers_to_exclude>
      </route>
      <route>
        <url>^/api/agent(?:/.*)?$</url>
        <verb>GET,POST,DELETE</verb>
        <access_level>ADMIN</access_level>
        <headers_to_exclude>[]</headers_to_exclude>
      </route>
      <route>
        <url>^/api/.*</url>
        <verb>GET,POST,PUT,DELETE</verb>
        <access_level>USER</access_level>
        <headers_to_exclude>[]</headers_to_exclude>
      </route>
      <route>
        <url>^/media/.*</url>
        <verb>GET</verb>
        <access_level>USER</access_level>
        <headers_to_exclude>[]</headers_to_exclude>
      </route>
      <route>
        <url>^/(js|css|img)/.*</url>
        <verb>GET</verb>
        <access_level>USER</access_level>
        <headers_to_exclude>[]</headers_to_exclude>
      </route>
    </routes>
  </external-app>
</info>
